<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>zonal-online</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Read buildings</from>
      <to>Buildings only</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buildings only</from>
      <to>Read nDSM</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read nDSM</from>
      <to>Height statistics</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Height statistics</from>
      <to>Remove raster value</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove raster value</from>
      <to>Write statistics</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buildings only</from>
      <to>Discard non-buildings</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read buildings</name>
    <type>SOGIS_VECTOR_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fileName>${PROJECT_HOME}/data/buildings.gpkg</fileName>
    <format>AUTO</format>
    <layerName>buildings</layerName>
    <geometryFieldName>geometrie</geometryFieldName>
    <timezone>UTC</timezone>
    <GUI>
      <xloc>45</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Buildings only</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>art_txt</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Gebaeude</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask />
        </value>
        <conditions />
      </condition>
    </compare>
    <send_true_to>Read nDSM</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <send_false_to>Discard non-buildings</send_false_to>
    <GUI>
      <xloc>180</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Read nDSM</name>
    <type>SOGIS_RASTER_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <source>https://files.geo.so.ch/ch.so.agi.lidar_2019.ndsm_buildings/aktuell/ch.so.agi.lidar_2019.ndsm_buildings.tif</source>
    <GUI>
      <xloc>315</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Height statistics</name>
    <type>SOGIS_RASTER_VALUE_ZONAL_STATS</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <geometryField>geometrie</geometryField>
    <explicitCrs>EPSG:2056</explicitCrs>
    <band>1</band>
    <statistics>mean min max</statistics>
    <prefix>height_</prefix>
    <GUI>
      <xloc>450</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Remove raster value</name>
    <type>SelectValues</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <remove>
        <name>raster</name>
      </remove>
    </fields>
    <GUI>
      <xloc>585</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write statistics</name>
    <type>SOGIS_VECTOR_WRITER</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <charset>UTF-8</charset>
    <comma>N</comma>
    <crsOverride>EPSG:2056</crsOverride>
    <decimals>2</decimals>
    <dimension>XY</dimension>
    <discardExtraOrdinates>N</discardExtraOrdinates>
    <fileName>${PROJECT_HOME}/output/zonal-online.gpkg</fileName>
    <flatGeobufIndex>Y</flatGeobufIndex>
    <flatGeobufSkipEmpty>N</flatGeobufSkipEmpty>
    <format>GEOPACKAGE</format>
    <geometryField>geometrie</geometryField>
    <geometryType>POLYGON</geometryType>
    <idField>building_id</idField>
    <layerDimension>XY</layerDimension>
    <layerGeometryType>POLYGON</layerGeometryType>
    <layerName>building_heights</layerName>
    <overwrite>N</overwrite>
    <parquetAlgorithm>SPHERICAL</parquetAlgorithm>
    <parquetCompression>GZIP</parquetCompression>
    <parquetLogicalType>GEOMETRY</parquetLogicalType>
    <parquetRowGroupSize>134217728</parquetRowGroupSize>
    <shapefileFields>
</shapefileFields>
    <skipEmpty>N</skipEmpty>
    <startId>1</startId>
    <timezone>UTC</timezone>
    <attributes />
    <fileGdbPrecisionMode>AUTO</fileGdbPrecisionMode>
    <fileGdbWriteMode>CREATE_DATABASE</fileGdbWriteMode>
    <geoPackageWriteMode>CREATE_FILE</geoPackageWriteMode>
    <geoPackageCreateSpatialIndex>Y</geoPackageCreateSpatialIndex>
    <GUI>
      <xloc>720</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Discard non-buildings</name>
    <type>Dummy</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>180</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
</pipeline>