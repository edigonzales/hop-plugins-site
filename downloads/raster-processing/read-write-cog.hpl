<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>read-write-cog</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Read nDSM</from>
      <to>Inspect raster</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Inspect raster</from>
      <to>Write COG</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write COG</from>
      <to>Remove raster value</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read nDSM</name>
    <type>SOGIS_RASTER_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <source>${PROJECT_HOME}/data/ndsm-2019.tif</source>
    <GUI>
      <xloc>100</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Inspect raster</name>
    <type>SOGIS_RASTER_INFO</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <prefix>info_</prefix>
    <infoFields>width height crs bands</infoFields>
    <GUI>
      <xloc>250</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write COG</name>
    <type>SOGIS_RASTER_WRITER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <output>${PROJECT_HOME}/output/read-write-cog.tif</output>
    <outputField>N</outputField>
    <format>COG</format>
    <compression>Deflate</compression>
    <addOverviews>Y</addOverviews>
    <overviews>AUTO</overviews>
    <overviewResampling>AVERAGE</overviewResampling>
    <overwrite>N</overwrite>
    <prefix>out_</prefix>
    <GUI>
      <xloc>400</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Remove raster value</name>
    <type>SelectValues</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <remove>
        <name>raster</name>
      </remove>
    </fields>
    <GUI>
      <xloc>550</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling />
</pipeline>