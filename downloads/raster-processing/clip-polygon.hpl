<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>clip-polygon</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Read buildings</from>
      <to>Buildings only</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buildings only</from>
      <to>Build output path</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build output path</from>
      <to>Read nDSM</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read nDSM</from>
      <to>Clip building</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clip building</from>
      <to>Write TIFFs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write TIFFs</from>
      <to>Drop raster</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buildings only</from>
      <to>Discard non-buildings</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read buildings</name>
    <type>SOGIS_VECTOR_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fileName>${PROJECT_HOME}/data/buildings.gpkg</fileName>
    <format>AUTO</format>
    <layerName>buildings</layerName>
    <geometryFieldName>geometrie</geometryFieldName>
    <timezone>UTC</timezone>
    <GUI>
      <xloc>45</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Buildings only</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>art_txt</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Gebaeude</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask />
        </value>
        <conditions />
      </condition>
    </compare>
    <send_true_to>Build output path</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <send_false_to>Discard non-buildings</send_false_to>
    <GUI>
      <xloc>180</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Build output path</name>
    <type>ScriptValueMod</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Output path</jsScript_name>
        <jsScript_script>var output_path = getVariable("PROJECT_HOME", "") + "/output/building-" + building_id + ".tif";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>output_path</name>
        <rename>output_path</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <GUI>
      <xloc>315</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Read nDSM</name>
    <type>SOGIS_RASTER_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <source>${PROJECT_HOME}/data/ndsm-2019.tif</source>
    <GUI>
      <xloc>450</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Clip building</name>
    <type>SOGIS_RASTER_VALUE_CLIP</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <clipMethod>POLYGON</clipMethod>
    <geometryField>geometrie</geometryField>
    <explicitCrs>EPSG:2056</explicitCrs>
    <bands>ALL</bands>
    <GUI>
      <xloc>585</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write TIFFs</name>
    <type>SOGIS_RASTER_WRITER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <output>output_path</output>
    <outputField>Y</outputField>
    <format>GEOTIFF</format>
    <compression>Deflate</compression>
    <addOverviews>Y</addOverviews>
    <overviews>AUTO</overviews>
    <overviewResampling>AVERAGE</overviewResampling>
    <overwrite>N</overwrite>
    <prefix>out_</prefix>
    <GUI>
      <xloc>720</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Drop raster</name>
    <type>SelectValues</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <remove>
        <name>raster</name>
      </remove>
    </fields>
    <GUI>
      <xloc>855</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Discard non-buildings</name>
    <type>Dummy</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>180</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
</pipeline>